@using WebApplication4.Models
@model List<Slider>
<div>
   
    <a asp-controller="Slider" asp-action="Create" class="btn btn-primary">Add Slider</a>
    <hr />
    <table class="table table-bordered border-primary">
    <thead>
        <tr>
            <th scope="col">Id</th>
            <th scope="col">Title</th>
            <th scope="col">Description</th>
            <th scope="col">Image</th>
            <th scope="col">Deleted Status</th>
        </tr>
    </thead>
    <tbody>
        @foreach (Slider slider in Model)
        {
            <tr>
                <th scope="row">@slider.Id</th>
                <td>@slider.Title</td>
                <td>@slider.Desc</td>
                <td>
                    <img style="width: 80px; height: 80px" src="~/uploads/sliders/@slider.ImageUrl" />
                </td>
                @{
                    if (slider.IsDeleted == false)
                    {
                        <td class="text-success">Silinmeyib</td>
                    }
                    else
                    {
                        <td class="text-danger">Silinib</td>
                    }
                }
                <td>
                    <a asp-controller="Slider" asp-action="Update" asp-route-id="@slider.Id" class="btn btn-warning">Update</a>
                </td>
                <td>

                    @{
                        if (slider.IsDeleted == false)
                        {
                            <form asp-controller="Slider" asp-action="Delete" asp-route-id="@slider.Id" method="post">
                                <button class="btn btn-danger">Delete</button>
                            </form>
                        }
                        else
                        {
                            <form asp-controller="Slider" asp-action="Restore" asp-route-id="@slider.Id" method="post">
                                <button class="btn btn-success">Restore</button>
                            </form>
                        }
                    }
                </td>
            </tr>
        }
    </tbody>
</table>
</div>
